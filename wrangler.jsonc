{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "subtitula-api",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-07-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  },
  "containers": [
    {
      "class_name": "SubtitulaApiContainer",
      "image": "./Dockerfile",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "API_CONTAINER",
        "class_name": "SubtitulaApiContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SubtitulaApiContainer"]
    }
  ],
  "env": {
    "development": {
      "name": "subtitula-api-dev",
      "vars": {
        "SPRING_PROFILES_ACTIVE": "dev",
        "EMAIL_PROVIDER": "disabled",
        "EMAIL_DELIVERY_REQUIRED": "false",
        "DB_POOL_MAXIMUM_SIZE": "5",
        "DB_POOL_MINIMUM_IDLE": "0",
        "DB_POOL_CONNECTION_TIMEOUT_MS": "10000",
        "ELEVENLABS_MODEL_ID": "scribe_v2",
        "ELEVENLABS_LANGUAGE_HINT": "glg",
        "CAPABILITY_DURABLE_INSTITUTIONAL_UPLOAD": "false",
        "CAPABILITY_NORMALIZED_TRANSCRIPT": "true",
        "CAPABILITY_EXCEPTION_REVIEW": "false",
        "CAPABILITY_AUTOMATIC_AGENDA": "false",
        "CAPABILITY_STRUCTURED_GUIDE": "false",
        "CAPABILITY_PUBLIC_PUBLICATION": "false",
        "CAPABILITY_LEXICAL_SEARCH": "false",
        "CAPABILITY_HYBRID_SEARCH": "false",
        "SEARCH_EMBEDDING_MODEL": "@cf/baai/bge-m3",
        "SEARCH_EMBEDDING_DIMENSIONS": "1024",
        "SEARCH_EMBEDDING_MICRO_USD_PER_MILLION_INPUT_TOKENS": "12000",
        "SEARCH_ESTIMATED_CHARS_PER_TOKEN": "3",
        "CORS_ORIGINS": "https://subtitula-web-dev.s-counago00.workers.dev",
        "FRONTEND_URL": "https://subtitula-web-dev.s-counago00.workers.dev",
        "GOOGLE_REDIRECT_URI": "https://subtitula-web-dev.s-counago00.workers.dev/backend/login/oauth2/code/google"
      },
      "containers": [
        {
          "class_name": "SubtitulaApiContainer",
          "image": "./Dockerfile",
          "instance_type": "basic",
          "max_instances": 1
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "API_CONTAINER",
            "class_name": "SubtitulaApiContainer"
          }
        ]
      }
    }
  }
}
