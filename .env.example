# Local development template. Copy to .env and fill only the values needed for
# the feature you are testing. Never commit the copy or paste secrets in chat.

# Local Postgres supplied by docker-compose.yml
DB_URL=jdbc:postgresql://localhost:5432/subtitula
DB_USER=subtitula
DB_PASSWORD=subtitula

# Browser/API pairing. In remote development both must be public HTTPS origins.
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Google Sign-In uses a Web OAuth client, not a Google API key. Leave blank to
# keep the local script's intentional dummy-login behaviour.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transcription is usage-billed. Use a distinct development key with a hard
# quota. Scribe v1 was retired; the application defaults to scribe_v2.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=scribe_v2
ELEVENLABS_LANGUAGE_HINT=glg

# Required only when testing email delivery with Amazon SES.
APP_EMAIL_FROM=
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Spring profile: dev for local work; prod only in a configured production host.
SPRING_PROFILES_ACTIVE=dev
