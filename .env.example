# Local end-to-end template. Copy to .env and fill only the external services
# you want to exercise. Never commit the copy or paste secrets in chat.

# Local Postgres supplied by docker-compose.yml
DB_URL=jdbc:postgresql://localhost:5432/subtitula
DB_USER=subtitula
DB_PASSWORD=subtitula

# Browser/API pairing for the local stack.
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google

# Google Sign-In uses a Web OAuth client, not a Google API key. The local script
# supplies dummy values when these are blank; password auth still works.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transcription is usage-billed. Use a distinct development key with a hard
# quota. Scribe v1 was retired; the application defaults to scribe_v2.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=scribe_v2
ELEVENLABS_LANGUAGE_HINT=glg

# Shared only between the local Spring API and processing Worker. Generate a
# random value of at least 32 bytes; never expose it to the browser.
INTERNAL_API_HMAC_SECRET=

# Optional privacy-minimized search analytics and cost assumptions. Raw query
# text is never stored. Keep the HMAC secret server-side and rotate by policy.
SEARCH_ANALYTICS_HMAC_SECRET=
SEARCH_EMBEDDING_MODEL=@cf/baai/bge-m3
SEARCH_EMBEDDING_DIMENSIONS=1024
SEARCH_EMBEDDING_MICRO_USD_PER_MILLION_INPUT_TOKENS=12000
SEARCH_ESTIMATED_CHARS_PER_TOKEN=3

# Rollout is server-controlled and fails closed. Enable one verified vertical
# slice at a time; hybrid remains false until the labelled relevance gate passes.
CAPABILITY_DURABLE_INSTITUTIONAL_UPLOAD=false
CAPABILITY_NORMALIZED_TRANSCRIPT=true
CAPABILITY_EXCEPTION_REVIEW=false
CAPABILITY_AUTOMATIC_AGENDA=false
CAPABILITY_STRUCTURED_GUIDE=false
CAPABILITY_PUBLIC_PUBLICATION=false
CAPABILITY_LEXICAL_SEARCH=false
CAPABILITY_HYBRID_SEARCH=false

# Local email is captured by Mailpit; no AWS credentials are used.
APP_EMAIL_FROM=no-reply@subtitula.local
SMTP_HOST=localhost
SMTP_PORT=1025

# local = Docker Postgres + Mailpit. Hosted environments use dev or prod.
SPRING_PROFILES_ACTIVE=local
