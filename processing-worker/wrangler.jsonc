{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "subtitula-processing",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  },
  "vars": {
    "ENVIRONMENT": "local",
    "API_ORIGIN": "http://localhost:8080",
    "ALLOWED_ORIGIN": "http://localhost:3000",
    "R2_BUCKET_NAME": "subtitula-media-dev",
    "R2_S3_ENDPOINT": "",
    "ELEVENLABS_API_BASE": "https://api.elevenlabs.io",
    "ELEVENLABS_MODEL_ID": "scribe_v2",
    "ELEVENLABS_SCRIBE_MICRO_USD_PER_HOUR": "220000",
    "ELEVENLABS_LANGUAGE_HINT": "glg",
    "ELEVENLABS_WEBHOOK_ID": "",
    "MAX_UPLOAD_BYTES": "1999999999",
    "UPLOAD_URL_TTL_SECONDS": "900",
    "UPLOAD_CLEANUP_GRACE_SECONDS": "3600",
    "SEARCH_ANALYTICS_RETENTION_DAYS": "90",
    "PROVIDER_SOURCE_TTL_SECONDS": "3600",
    "WEBHOOK_MAX_BYTES": "67108864",
    "GUIDE_MODEL_ID": "@cf/zai-org/glm-4.7-flash",
    "GUIDE_PROMPT_VERSION": "guide-v1",
    "GUIDE_SCHEMA_VERSION": "1.0.0",
    "GUIDE_MAX_WINDOW_CHARS": "24000",
    "GUIDE_INPUT_MICRO_USD_PER_MILLION_TOKENS": "60000",
    "GUIDE_OUTPUT_MICRO_USD_PER_MILLION_TOKENS": "400000",
    "MEDIA_URL_TTL_SECONDS": "900",
    "EMBEDDING_MODEL_ID": "@cf/baai/bge-m3",
    "EMBEDDING_DIMENSIONS": "1024",
    "EMBEDDING_BATCH_SIZE": "24",
    "EMBEDDING_INPUT_MICRO_USD_PER_MILLION_TOKENS": "12000",
    "ESTIMATED_CHARS_PER_TOKEN": "3"
  },
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "SEARCH_RATE_LIMITER",
      "namespace_id": "10001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "MUTATION_RATE_LIMITER",
      "namespace_id": "10003",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "subtitula-media-dev"
    }
  ],
  "workflows": [
    {
      "binding": "INGEST_SESSION",
      "name": "subtitula-ingest-local",
      "class_name": "IngestSessionWorkflow"
    },
    {
      "binding": "ENRICH_SESSION",
      "name": "subtitula-enrich-local",
      "class_name": "EnrichSessionWorkflow"
    },
    {
      "binding": "INDEX_PUBLICATION",
      "name": "subtitula-index-local",
      "class_name": "IndexPublicationWorkflow"
    }
  ],
  "env": {
    "development": {
      "name": "subtitula-processing-dev",
      "vars": {
        "ENVIRONMENT": "development",
        "API_ORIGIN": "https://subtitula-api-dev.s-counago00.workers.dev",
        "ALLOWED_ORIGIN": "https://subtitula-web-dev.s-counago00.workers.dev",
        "R2_BUCKET_NAME": "subtitula-media-dev",
        "R2_S3_ENDPOINT": "",
        "ELEVENLABS_API_BASE": "https://api.elevenlabs.io",
        "ELEVENLABS_MODEL_ID": "scribe_v2",
        "ELEVENLABS_SCRIBE_MICRO_USD_PER_HOUR": "220000",
        "ELEVENLABS_LANGUAGE_HINT": "glg",
        "ELEVENLABS_WEBHOOK_ID": "",
        "MAX_UPLOAD_BYTES": "1999999999",
        "UPLOAD_URL_TTL_SECONDS": "900",
        "UPLOAD_CLEANUP_GRACE_SECONDS": "3600",
        "SEARCH_ANALYTICS_RETENTION_DAYS": "90",
        "PROVIDER_SOURCE_TTL_SECONDS": "3600",
        "WEBHOOK_MAX_BYTES": "67108864",
        "GUIDE_MODEL_ID": "@cf/zai-org/glm-4.7-flash",
        "GUIDE_PROMPT_VERSION": "guide-v1",
        "GUIDE_SCHEMA_VERSION": "1.0.0",
        "GUIDE_MAX_WINDOW_CHARS": "24000",
        "GUIDE_INPUT_MICRO_USD_PER_MILLION_TOKENS": "60000",
        "GUIDE_OUTPUT_MICRO_USD_PER_MILLION_TOKENS": "400000",
        "MEDIA_URL_TTL_SECONDS": "900",
        "EMBEDDING_MODEL_ID": "@cf/baai/bge-m3",
        "EMBEDDING_DIMENSIONS": "1024",
        "EMBEDDING_BATCH_SIZE": "24",
        "EMBEDDING_INPUT_MICRO_USD_PER_MILLION_TOKENS": "12000",
        "ESTIMATED_CHARS_PER_TOKEN": "3"
      },
      "triggers": {
        "crons": ["17 3 * * *"]
      },
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "subtitula-media-dev"
        }
      ],
      "ai": {
        "binding": "AI"
      },
      "ratelimits": [
        {
          "name": "SEARCH_RATE_LIMITER",
          "namespace_id": "10002",
          "simple": {
            "limit": 60,
            "period": 60
          }
        },
        {
          "name": "MUTATION_RATE_LIMITER",
          "namespace_id": "10004",
          "simple": {
            "limit": 10,
            "period": 60
          }
        }
      ],
      "services": [
        {
          "binding": "API_SERVICE",
          "service": "subtitula-api-dev"
        }
      ],
      "workflows": [
        {
          "binding": "INGEST_SESSION",
          "name": "subtitula-ingest-dev",
          "class_name": "IngestSessionWorkflow"
        },
        {
          "binding": "ENRICH_SESSION",
          "name": "subtitula-enrich-dev",
          "class_name": "EnrichSessionWorkflow"
        },
        {
          "binding": "INDEX_PUBLICATION",
          "name": "subtitula-index-dev",
          "class_name": "IndexPublicationWorkflow"
        }
      ]
    }
  }
}
