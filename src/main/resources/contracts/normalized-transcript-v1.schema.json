{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://subtitula.gal/contracts/normalized-transcript-v1.schema.json",
  "title": "Subtitula normalized transcript v1",
  "description": "Provider-neutral, diarization-aware transcript command sent by the processing Worker to the canonical Spring API.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "jobId",
    "provider",
    "model",
    "languageCode",
    "durationMs",
    "sourceArtifact",
    "speakers",
    "segments"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "projectId": {
      "$ref": "#/$defs/uuid"
    },
    "jobId": {
      "$ref": "#/$defs/uuid"
    },
    "provider": {
      "const": "elevenlabs"
    },
    "model": {
      "const": "scribe_v2"
    },
    "languageCode": {
      "type": "string",
      "pattern": "^[a-z]{2,3}$"
    },
    "languageProbability": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1
    },
    "durationMs": {
      "type": "integer",
      "minimum": 1
    },
    "sourceArtifact": {
      "$ref": "#/$defs/artifact"
    },
    "speakers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/speaker"
      }
    },
    "segments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/segment"
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objectKey",
        "sha256",
        "sizeBytes"
      ],
      "properties": {
        "objectKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 2
        }
      }
    },
    "speaker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerLabel",
        "identityState"
      ],
      "properties": {
        "providerLabel": {
          "type": "string",
          "pattern": "^speaker_[0-9]+$"
        },
        "identityState": {
          "const": "unknown"
        }
      }
    },
    "word": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceWordId",
        "text",
        "startMs",
        "endMs",
        "type",
        "speakerProviderLabel"
      ],
      "properties": {
        "sourceWordId": {
          "type": "string",
          "pattern": "^w[0-9]+$"
        },
        "text": {
          "type": "string"
        },
        "startMs": {
          "type": "integer",
          "minimum": 0
        },
        "endMs": {
          "type": "integer",
          "minimum": 0
        },
        "type": {
          "enum": [
            "word",
            "spacing",
            "audio_event"
          ]
        },
        "speakerProviderLabel": {
          "type": ["string", "null"],
          "pattern": "^speaker_[0-9]+$"
        },
        "logProbability": {
          "type": ["number", "null"],
          "maximum": 0
        }
      }
    },
    "signals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "speakerChanged",
        "hasLowLogProbability",
        "hasAudioEvent",
        "hasMissingTiming",
        "properNameCandidates"
      ],
      "properties": {
        "speakerChanged": {
          "type": "boolean"
        },
        "hasLowLogProbability": {
          "type": "boolean"
        },
        "hasAudioEvent": {
          "type": "boolean"
        },
        "hasMissingTiming": {
          "type": "boolean"
        },
        "properNameCandidates": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceSegmentId",
        "sequence",
        "startMs",
        "endMs",
        "speakerProviderLabel",
        "originalText",
        "reviewedText",
        "words",
        "signals"
      ],
      "properties": {
        "sourceSegmentId": {
          "type": "string",
          "pattern": "^s[0-9]+$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "startMs": {
          "type": "integer",
          "minimum": 0
        },
        "endMs": {
          "type": "integer",
          "minimum": 1
        },
        "speakerProviderLabel": {
          "type": ["string", "null"],
          "pattern": "^speaker_[0-9]+$"
        },
        "originalText": {
          "type": "string",
          "minLength": 1
        },
        "reviewedText": {
          "type": "string",
          "minLength": 1
        },
        "words": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/word"
          }
        },
        "signals": {
          "$ref": "#/$defs/signals"
        }
      }
    }
  }
}
